<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Zebra TC27 e-Connectix uses the Zebra RFID host service — no Bluetooth permissions needed -->

    <!-- Override library minSdk (26) since app supports minSdk 24 -->
    <uses-sdk tools:overrideLibrary="com.zebra.rfid.api3,com.zebra.rfid.api3.cmn,com.zebra.rfid.api3.iface,com.zebra.rfid.api3.transport,com.zebra.rfid.api3.ascii,com.zebra.rfidhostlib,com.zebra.rfidseriallib" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EFRidTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EFRidTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>